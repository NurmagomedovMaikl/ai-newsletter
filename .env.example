# ============================================================
# AI Newsletter — Environment Variablen (Beispiel)
# Kopiere diese Datei zu ".env" und fülle die echten Werte ein.
# NIEMALS echte Keys committen — ".env" ist per .gitignore ausgeschlossen.
# ============================================================

# --- Supabase (Datenbank + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM: Groq (Primary) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM: OpenRouter (Fallback bei Rate-Limit/Ausfall) ---
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Email: Resend (transaktional) ---
RESEND_API_KEY=re_xxxxxxxxxx
NEWSLETTER_FROM_EMAIL=no-reply@yourdomain.com
NEWSLETTER_FROM_NAME=AI Newsletter
ADMIN_EMAIL=you@example.com

# --- Zahlungen: LemonSqueezy ---
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LEMONSQUEEZY_PRODUCT_ID=your-product-id
LEMONSQUEEZY_VARIANT_ID=your-variant-id

# --- NewsAPI (Recherche, Free-Tier) ---
NEWSAPI_KEY=your-newsapi-key

# --- QA / Fake-News-Check Stufe 2 (optional) ---
# Google Fact Check Tools API (kostenlos, Key via Google Cloud Console)
GOOGLE_FACTCHECK_API_KEY=your-google-factcheck-api-key

# --- Bildgenerierung: Cloudflare Workers AI (Free-Tier, Entscheidung E-014) ---
# API-Token erstellen: Cloudflare Dashboard → My Profile → API Tokens → Create Token
# (Permission "Workers AI: Run", Account Resource, Edit Zone nicht nötig)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# --- Basis-URL (lokal = http://localhost:3000) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
