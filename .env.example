# ============================================================
# AI Newsletter — Environment Variablen (Beispiel)
# Kopiere diese Datei zu ".env" und fülle die echten Werte ein.
# NIEMALS echte Keys committen — ".env" ist per .gitignore ausgeschlossen.
# ============================================================

# --- Supabase (Datenbank + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM: Groq (Primary) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM: OpenRouter (Fallback bei Rate-Limit/Ausfall) ---
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Email: Resend (transaktional) ---
RESEND_API_KEY=re_xxxxxxxxxx
# Test: onboarding@resend.dev (sendet nur an deine eigene E-Mail). Für echten Versand
# eigene Domain verifizieren (Resend → Domains → SPF/DKIM DNS-Einträge setzen).
NEWSLETTER_FROM_EMAIL=onboarding@resend.dev
NEWSLETTER_FROM_NAME=AI Newsletter
ADMIN_EMAIL=you@example.com
# Signatur-Key für den Resend-Webhook (Bounce-Handling) — Resend → Webhooks → Signing secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxx
# Secret zum Absichern der Cron-/Send-Routes (/api/send-weekly) und der Unsubscribe-Tokens
CRON_SECRET=generate-a-long-random-string
UNSUBSCRIBE_SECRET=another-long-random-string

# --- Zahlungen: LemonSqueezy ---
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LEMONSQUEEZY_PRODUCT_ID=your-product-id
LEMONSQUEEZY_VARIANT_ID=your-variant-id
LEMONSQUEEZY_STORE_ID=your-store-id
# Store-URL für das Customer-Portal (Fallback-Link ohne API-Key), z.B. https://mein-store.lemonsqueezy.com
LEMONSQUEEZY_STORE_URL=https://your-store.lemonsqueezy.com

# --- NewsAPI (Recherche, Free-Tier) ---
NEWSAPI_KEY=your-newsapi-key

# --- QA / Fake-News-Check Stufe 2 (optional) ---
# Google Fact Check Tools API (kostenlos, Key via Google Cloud Console)
GOOGLE_FACTCHECK_API_KEY=your-google-factcheck-api-key

# --- Bildgenerierung: Cloudflare Workers AI (Free-Tier, Entscheidung E-014) ---
# API-Token erstellen: Cloudflare Dashboard → My Profile → API Tokens → Create Token
# (Permission "Workers AI: Run", Account Resource, Edit Zone nicht nötig)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# --- Basis-URL (lokal = http://localhost:3000) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- GitHub Actions (Phase 8) ---
# Die gleichen Keys als Repository-Secrets hinterlegen (Settings → Secrets and
# variables → Actions): NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# GROQ_API_KEY, OPENROUTER_API_KEY, CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN,
# NEWSAPI_KEY, GOOGLE_FACTCHECK_API_KEY, RESEND_API_KEY, NEWSLETTER_FROM_EMAIL,
# ADMIN_EMAIL, CRON_SECRET + NEWSLETTER_APP_URL (https://<dein-app>.vercel.app).
# Workflow: .github/workflows/weekly.yml (wöchentlich + workflow_dispatch).
